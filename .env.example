# Copy to .env and fill in. .env is gitignored.

# Required: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: free static domain from https://dashboard.ngrok.com/domains
# (also switch the ngrok `command` in docker-compose.yml)
NGROK_DOMAIN=

# Host port for the nginx site
WEB_PORT=8080

# github (Phase 1) | api (Phase 2+)
VITE_DATA_SOURCE=github

# Phase 2+
# GITHUB_TOKEN=
# Phase 3+
# POSTGRES_PASSWORD=
